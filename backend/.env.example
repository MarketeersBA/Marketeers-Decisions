# Optional: override studies directory (default: backend/studies/)
# MARKET_SIM_STUDIES_DIR=D:\path\to\studies

APP_ENV=development
MARKET_SIM_STORAGE=local
MARKET_SIM_AUTH=dev
MARKET_SIM_DEV_CLIENT_ID=local-dev

# S3 (production / optional local testing)
# MARKET_SIM_STORAGE=s3
# MARKET_SIM_S3_BUCKET=marketsimulator-studies-dev
# AWS_REGION=eu-west-1

# Database — SQLite locally (default), Postgres on RDS in production
# DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/marketsim

# Display formatting
MARKET_SIM_DECIMALS=2

# Brand Optimizer: mock unit cost = base price × random ratio per SKU in [lo, hi]
# MARKET_SIM_MOCK_UNIT_COST_RATIO_LO=0.5
# MARKET_SIM_MOCK_UNIT_COST_RATIO_HI=0.65
